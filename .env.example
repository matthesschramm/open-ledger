# Open Ledger Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration
# Get these from your Supabase project settings at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT: NEVER commit SUPABASE_SERVICE_ROLE_KEY to version control!
# The service role key should ONLY be used server-side in secure environments.
# For local development, set it in .env.local (which is git-ignored).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application URL (for email redirects and API documentation)
# Set this to your deployment URL in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend API Configuration (for sending invoice emails)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Platform default From address for invoice emails (used for all companies unless overridden per-company)
# Must be a verified domain in your Resend account
RESEND_PLATFORM_FROM=invoices@example.com

# Legacy fallback (deprecated, use RESEND_PLATFORM_FROM instead)
RESEND_FROM_EMAIL=invoices@example.com
